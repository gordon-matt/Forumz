<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<Description>A Blazor forum that mounts into any ASP.NET Core site.</Description>
		<PackageTags>forums;forumz;blazor;razor-class-library</PackageTags>
		<RootNamespace>Forumz</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EasyChatz.AspNetCore" Version="2.0.1" />
		<PackageReference Include="EasyChatz.Components" Version="2.0.1" />
		<PackageReference Include="Heroicsoft.NetForge.Components" Version="1.2.6" />
		<PackageReference Include="Heroicsoft.NetForge.WebAssets" Version="1.2.6" />
		<PackageReference Include="Pickstack" Version="1.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Forumz.Services\Forumz.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\Forumz.props" Pack="true" PackagePath="build;buildTransitive" />
	</ItemGroup>

</Project>