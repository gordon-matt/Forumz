<div class="fz-composer" @ref="root">
    @if (Capabilities.CanChooseFormat)
    {
        <div class="nf-chip-row" role="group" aria-label="Editor">
            <Chip Selected="@(Format == ContentFormat.Markdown)" OnClick="() => SwitchAsync(ContentFormat.Markdown)">Markdown</Chip>
            <Chip Selected="@(Format == ContentFormat.Html)" OnClick="() => SwitchAsync(ContentFormat.Html)">Rich text</Chip>
        </div>
    }

    @if (Format == ContentFormat.Html && Capabilities.HasRichTextEditor)
    {
        <PickstackEditor @key="generation" Value="@Text" ValueChanged="TextChanged" Height="280" FileManager="@Capabilities.HasFileManager" />
    }
    else
    {
        <MarkdownEditor @ref="markdown" @key="generation" Value="@Text" ValueChanged="TextChanged" Rows="8" AriaLabel="@Label" Placeholder="Write your post. Markdown is welcome.">
            <ToolbarExtra>
                <button type="button" class="nf-icon-button" title="Insert image" aria-label="Insert image" @onclick="ChooseImageAsync"><Icon Name="image" Size="16" /></button>
                @if (!Capabilities.HasFileManager)
                {
                    <input @ref="imageFile" class="fz-file-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp" tabindex="-1" aria-hidden="true" @onchange="UploadLocalImageAsync" />
                }
            </ToolbarExtra>
            <Preview Context="source">
                <div class="nf-markdown">@((MarkupString)Renderer.ToHtml(source, ContentFormat.Markdown))</div>
            </Preview>
        </MarkdownEditor>
    }
    @if (pickError is not null)
    {
        <p class="nf-validation">@pickError</p>
    }
</div>
