@inherits LayoutComponentBase
@inject IOptions<ForumzOptions> Options
@inject ForumUrls Urls

@* The host already has its top bar. The forum's links sit under it, and the page is the body. *@
@if (Options.Value.PublicLayout is { } layout)
{
    <LayoutView Layout="layout">
        <HeadContent>
            <link rel="stylesheet" href="@Urls.Stylesheet" />
            <link rel="stylesheet" href="/_content/EasyChatz.Components/easychatz.css" />
        </HeadContent>
        <ForumSubNav />
        @Body
    </LayoutView>
}
else
{
    @Body
}
