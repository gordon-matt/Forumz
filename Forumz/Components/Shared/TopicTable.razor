@if (Topics.Count == 0)
{
    <EmptyState Icon="chat" Title="@EmptyTitle" Description="@EmptyDescription" />
}
else
{
    <div class="fz-board">
        <table>
            <thead>
                <tr>
                    <th scope="col">Topic</th>
                    @if (ShowForum)
                    {
                        <th class="fz-forum-cell" scope="col">Forum</th>
                    }
                    <th class="fz-count" scope="col">Activity</th>
                    <th class="fz-latest" scope="col">Last post</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var topic in Topics)
                {
                    <tr class="@RowClass(topic.TopicType)">
                        <td>
                            <div class="fz-subject">
                                <a href="@Urls.To($"topic/{topic.Id}")">@topic.Subject</a>
                                @if (topic.TopicType != ForumTopicType.Normal)
                                {
                                    <span class="nf-badge nf-badge-accent">@topic.TopicType</span>
                                }
                            </div>
                            <div class="fz-sub">Started by @topic.AuthorName</div>
                        </td>
                        @if (ShowForum)
                        {
                            <td class="fz-forum-cell"><a href="@Urls.To($"forum/{topic.ForumId}")">@topic.ForumName</a></td>
                        }
                        <td class="fz-count">
                            <span><b>@topic.ReplyCount</b> replies</span>
                            <span><b>@topic.Views</b> views</span>
                        </td>
                        <td class="fz-latest">
                            @if (topic.LastPostTime is DateTime whenUtc)
                            {
                                <span title="@ForumTime.Exact(whenUtc)">@ForumTime.Format(whenUtc, Relative, Clock)</span>
                                <div class="fz-sub">@topic.LastAuthorName</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TopicRowModel> Topics { get; set; } = [];

    [Parameter]
    public bool ShowForum { get; set; }

    [Parameter]
    public bool Relative { get; set; } = true;

    [Parameter]
    public string EmptyTitle { get; set; } = "No topics yet";

    [Parameter]
    public string EmptyDescription { get; set; } = "Start one, or check back later.";

    [Inject]
    private TimeProvider Clock { get; set; } = default!;

    [Inject]
    private ForumUrls Urls { get; set; } = default!;

    private static string? RowClass(ForumTopicType type) => type switch
    {
        ForumTopicType.Sticky => "is-sticky",
        ForumTopicType.Announcement => "is-announce",
        _ => null,
    };
}
