@using EasyChatz.Components
@using Microsoft.JSInterop
@inject IOptions<ForumzOptions> Options
@inject IOptions<ForgeShellOptions> Shell
@inject IUserContextService Users
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IServiceProvider ScriptServices

<AppShell Brand="@Brand"
          BrandHref="@(string.IsNullOrWhiteSpace(Options.Value.HomePath) ? "./" : Options.Value.HomePath)"
          EnhanceBrandNavigation="false"
          LogoUrl="@ForgeBrand.Logo(Shell.Value)"
          LogoDarkUrl="@ForgeBrand.LogoDark(Shell.Value)"
          MarkUrl="@ForgeBrand.Mark(Shell.Value)"
          NavigationPlacement="ForgeNavigationPlacement.Topbar"
          Sections="sections"
          ShowSearch="true"
          SearchPlaceholder="Search topics"
          OnSearch="Search"
          ShowThemePicker="true"
          ShowUserMenu="false"
          ShowVersion="false">
    <TopbarEnd>
        @if (Options.Value.TopbarComponent is { } topbar)
        {
            <DynamicComponent Type="topbar" />
        }
        @if (!string.IsNullOrWhiteSpace(account))
        {
            <a class="nf-button" href="profile">@account</a>
        }
        @if (!string.IsNullOrWhiteSpace(Options.Value.HomePath))
        {
            <a class="nf-icon-button" href="@Options.Value.HomePath" title="Back to the site" data-enhance-nav="false">
                <Icon Name="arrow-left" />
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(Options.Value.LogoutPath))
        {
            <form method="post" action="@Options.Value.LogoutPath" data-enhance="false">
                <button type="submit" class="nf-icon-button" title="Sign out">
                    <Icon Name="logout" />
                </button>
            </form>
        }
    </TopbarEnd>
    <ChildContent>
        @ChildContent
    </ChildContent>
</AppShell>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private IReadOnlyList<ForgeNavSection> sections = [];
    private string? account;

    private string Brand => ForgeBrand.Name(Shell.Value) ?? Options.Value.Title;

    protected override void OnInitialized()
    {
        account = Users.IsAuthenticated() ? Users.GetCurrentUserName() : null;
        var items = new List<ForgeNavItem>
        {
            new() { Title = "Forums", Href = "./", Icon = "chat", MatchAll = true },
            new() { Title = "Active", Href = "active", Icon = "clock" },
            new() { Title = "Search", Href = "search", Icon = "search" },
        };

        if (Users.IsAuthenticated())
        {
            items.Add(new ForgeNavItem { Title = "Subscriptions", Href = "subscriptions", Icon = "bookmark" });
            items.Add(new ForgeNavItem
            {
                Title = "Messages",
                Href = "messages",
                Icon = "inbox",
                BadgeComponent = typeof(ChatUnreadBadge),
                BadgeParameters = new Dictionary<string, object>
                {
                    ["Theme"] = "netforge",
                    ["Class"] = "nf-nav-badge",
                    ["TrackPresence"] = true,
                },
            });
        }

        sections = [new ForgeNavSection { Items = items }];
    }

    private void Search(string text)
    {
        string term = text?.Trim() ?? string.Empty;
        Navigation.NavigateTo(term.Length == 0 ? "search" : $"search?q={Uri.EscapeDataString(term)}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // PickstackScripts lets a failed import dispose the whole circuit. A host can refuse this
        // script to anonymous visitors, and the forum still has to open. Editors that can reach it still load.
        var includes = PickstackPageScripts.Resolve(ScriptServices);
        if (includes.Count == 0)
        {
            return;
        }

        try
        {
            await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "/pickstack/assets/load.js");
            await module.InvokeVoidAsync("load", includes);
        }
        catch (JSException)
        {
        }
    }
}
