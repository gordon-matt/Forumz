@page "/subscriptions"
@inject IForumService Forums
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject TimeProvider Clock

<PageTitle>Subscriptions</PageTitle>

<div class="fz-page">
    <ForumHeading Title="Subscriptions" Description="Forums and topics you follow." />
    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="Subscriptions could not be loaded" Description="@error" />
    }
    else if (model is not null && model.Items.Count == 0)
    {
        <EmptyState Icon="bookmark" Title="You are not following anything" Description="Subscribe from a forum or a topic." />
    }
    else if (model is not null)
    {
        <div class="nf-table-wrap">
            <table class="nf-table">
                <thead>
                    <tr>
                        <th>Following</th>
                        <th>Since</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in model.Items)
                    {
                        <tr>
                            <td>
                                @if (item.TopicId is int topicId)
                                {
                                    <a href="@($"topic/{topicId}")">@item.TopicSubject</a>
                                    <div class="nf-hint">@item.ForumName</div>
                                }
                                else
                                {
                                    <a href="@($"forum/{item.ForumId}")">@item.ForumName</a>
                                    <div class="nf-hint">Whole forum</div>
                                }
                            </td>
                            <td class="nf-cell-nowrap" title="@ForumTime.Exact(item.CreatedOnUtc)">@ForumTime.Format(item.CreatedOnUtc, true, Clock)</td>
                            <td class="nf-cell-actions">
                                <button type="button" class="nf-button" @onclick="() => LeaveAsync(item.Id)">Unsubscribe</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager PageNumber="model.PageNumber" PageSize="model.PageSize" TotalCount="model.TotalCount" PageSizes="sizes" PageNumberChanged="Go" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int PageNumber { get; set; }

    private SubscriptionListModel? model;
    private string? error;
    private bool loading = true;
    private int[] sizes = [20];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = model is null;
        var result = await Forums.GetSubscriptionsAsync(PageNumber < 1 ? 1 : PageNumber);
        loading = false;
        if (!result.IsSuccess)
        {
            error = result.GetDisplayMessage();
            model = null;
            return;
        }

        error = null;
        model = result.Value;
        sizes = [model.PageSize];
    }

    private void Go(int page) => Navigation.NavigateTo($"subscriptions?page={page}");

    private async Task LeaveAsync(int id)
    {
        var result = await Forums.UnsubscribeAsync(id);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        await LoadAsync();
    }
}
