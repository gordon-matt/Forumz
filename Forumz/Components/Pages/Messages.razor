@page "/messages"
@using EasyChatz.Components

<PageTitle>Messages</PageTitle>

<div class="fz-chat">
    <Chat Theme="netforge" Height="100%" WithUserId="@WithUser" ConnectOnOpen="@(!string.IsNullOrWhiteSpace(WithUser))" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "withUser")]
    public string? WithUser { get; set; }
}
