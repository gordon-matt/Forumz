@page "/profile"
@using Microsoft.JSInterop
@inject IForumService Forums
@inject IProfileProvider Profiles
@inject IUserContextService Users
@inject IOptions<ForumzOptions> Options
@inject ForumUrls Urls
@inject IJSRuntime Js
@inject ToastService Toasts

<PageTitle>Profile</PageTitle>

<div class="fz-page">
    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="Your profile could not be loaded" Description="@error" />
    }
    else
    {
        <ForumHeading Title="Your profile" Description="@($"{posts} posts")" />
        @if (photosEnabled)
        {
            <div class="fz-profile-photo">
                <span class="fz-avatar" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(photoUri))
                    {
                        <img src="@photoUri" alt="" />
                    }
                    else
                    {
                        @ForumInitials.From(form.DisplayName)
                    }
                </span>
                <div>
                    <InputFile @ref="photoInput" OnChange="UploadPhotoAsync" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <span class="nf-hint">JPEG, PNG, GIF, or WebP. Up to 2 MB.</span>
                    @if (!string.IsNullOrEmpty(photoUri))
                    {
                        <button type="button" class="nf-button" @onclick="RemovePhotoAsync">Remove photo</button>
                    }
                </div>
            </div>
        }
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <Field Label="Display name" For="profile-name">
                <InputText id="profile-name" class="nf-input" @bind-Value="form.DisplayName" />
                <span class="nf-hint">This is the name on your posts. People use it when they send you a message.</span>
            </Field>
            <Field Label="Signature" For="profile-signature">
                <InputTextArea id="profile-signature" class="nf-textarea" rows="4" @bind-Value="form.Signature" />
            </Field>
            <div class="nf-form-actions">
                <button type="submit" class="nf-button nf-button-primary" disabled="@saving">Save</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private readonly ProfileForm form = new();
    private InputFile? photoInput;
    private string? error;
    private bool loading = true;
    private bool saving;
    private int posts;
    private bool photosEnabled;
    private string photoUri = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await Forums.GetProfileAsync();
        loading = false;
        if (!result.IsSuccess)
        {
            error = result.GetDisplayMessage();
            return;
        }

        form.DisplayName = result.Value.DisplayName;
        form.Signature = result.Value.Signature;
        posts = result.Value.PostCount;
        photosEnabled = Options.Value.ProfilePhotosEnabled;
        if (photosEnabled)
        {
            string? userId = Users.GetCurrentUserId();
            photoUri = string.IsNullOrWhiteSpace(userId) ? string.Empty : (await Profiles.GetAsync(userId)).PhotoUri;
        }
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs args)
    {
        // Do not open the browser file stream. On a host circuit its chunks never arrive, and the
        // framework then reports that wait as an unhandled circuit error.
        if (photoInput?.Element is not { } element || args.File is null)
        {
            return;
        }

        try
        {
            await using var module = await Js.InvokeAsync<IJSObjectReference>("import", Urls.Asset("forumz-upload.js"));
            var outcome = await module.InvokeAsync<PhotoUploadOutcome>("upload", element, Urls.To("profile-photo"));
            if (!outcome.Ok)
            {
                Toasts.Error(string.IsNullOrWhiteSpace(outcome.Message)
                    ? "The photo could not be uploaded. Try a smaller image."
                    : outcome.Message);
                return;
            }

            photoUri = outcome.PhotoUri;
            Toasts.Success("Photo saved.");
        }
        catch (JSException)
        {
            Toasts.Error("The photo could not be uploaded. Try a smaller image.");
        }
    }

    private async Task RemovePhotoAsync()
    {
        string? userId = Users.GetCurrentUserId();
        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        var result = await Profiles.RemoveAsync(userId);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        photoUri = string.Empty;
        Toasts.Success("Photo removed.");
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        var result = await Forums.SaveProfileAsync(new SaveProfileRequest(form.DisplayName, form.Signature));
        saving = false;
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Profile saved.");
    }

    private sealed class PhotoUploadOutcome
    {
        public bool Ok { get; set; }

        public string Message { get; set; } = string.Empty;

        public string PhotoUri { get; set; } = string.Empty;
    }

    private sealed class ProfileForm
    {
        public string DisplayName { get; set; } = string.Empty;

        public string Signature { get; set; } = string.Empty;
    }
}
