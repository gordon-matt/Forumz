@page "/"
@inject IForumService Forums
@inject ForumUrls Urls
@inject ToastService Toasts
@inject DialogService Dialogs
@inject TimeProvider Clock

<PageTitle>Forums</PageTitle>

<div class="fz-page">
    <ForumHeading Title="Forums" Description="Groups, forums, and the latest reply in each.">
        <Actions>
            @if (feedsEnabled)
            {
                <a class="nf-button" href="@Urls.To("feed")" data-enhance-nav="false">RSS</a>
            }
            @if (model?.CanManage == true)
            {
                <button type="button" class="nf-button" @onclick="EditSettings">Settings</button>
                <button type="button" class="nf-button nf-button-primary" @onclick="NewGroup">New group</button>
            }
        </Actions>
    </ForumHeading>

    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="The forums could not be loaded" Description="@error" />
    }
    else if (model!.Groups.Count == 0)
    {
        <EmptyState Icon="chat" Title="No forums yet" Description="@(model.CanManage ? "Add a group, then add a forum inside it." : "An administrator can add the first group.")" />
    }
    else
    {
        @foreach (var group in model.Groups)
        {
            var editable = GroupEdit(group.Id);
            <section class="fz-board">
                <div class="fz-board-head">
                    <h2 class="fz-board-title">@group.Name</h2>
                    @if (editable is not null)
                    {
                        <div class="fz-actions">
                            <button type="button" class="nf-button nf-button-sm" @onclick="() => EditGroup(editable)">Edit</button>
                            <button type="button" class="nf-button nf-button-sm" @onclick="() => NewForum(editable)">Add forum</button>
                            <button type="button" class="nf-button nf-button-sm nf-button-danger" @onclick="() => DeleteGroupAsync(editable)">Delete</button>
                        </div>
                    }
                </div>
                @if (group.Forums.Count == 0)
                {
                    <p class="fz-empty">No forums in this group.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Forum</th>
                                <th class="fz-count" scope="col">Activity</th>
                                <th class="fz-latest" scope="col">Last post</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var forum in group.Forums)
                            {
                                var forumEdit = ForumEdit(forum.Id);
                                <tr>
                                    <td>
                                        <div class="fz-forum-title">
                                            <span class="fz-mark" aria-hidden="true"><Icon Name="chat" /></span>
                                            <div>
                                                <div class="fz-subject"><a href="@Urls.To($"forum/{forum.Id}")">@forum.Name</a></div>
                                                @if (forum.Description.Length > 0)
                                                {
                                                    <div class="fz-sub">@forum.Description</div>
                                                }
                                            </div>
                                            @if (forumEdit is not null)
                                            {
                                                <div class="fz-actions fz-row-actions">
                                                    <button type="button" class="nf-button nf-button-sm" @onclick="() => EditForum(forumEdit)">Edit</button>
                                                    <button type="button" class="nf-button nf-button-sm nf-button-danger" @onclick="() => DeleteForumAsync(forumEdit)">Delete</button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="fz-count">
                                        <span><b>@forum.TopicCount</b> topics</span>
                                        <span><b>@forum.PostCount</b> posts</span>
                                    </td>
                                    <td class="fz-latest">
                                        @if (forum.LastPostTime is DateTime whenUtc && forum.LastTopicId is int topicId)
                                        {
                                            <a href="@Urls.To($"topic/{topicId}")" title="@ForumTime.Exact(whenUtc)">@ForumTime.Format(whenUtc, relative, Clock)</a>
                                            <div class="fz-sub">@forum.LastAuthorName</div>
                                        }
                                        else
                                        {
                                            <span class="nf-muted">No posts</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    }
</div>

<Drawer Open="groupOpen" Scrim="true" Title="@(groupForm.Id is null ? "New group" : "Edit group")" Width="min(480px, 100vw)" OnClose="() => groupOpen = false">
    <ChildContent>
        <Field Label="Name" For="group-name">
            <InputText id="group-name" class="nf-input" @bind-Value="groupForm.Name" />
        </Field>
        <Field Label="Order" For="group-order">
            <InputNumber id="group-order" class="nf-input" @bind-Value="groupForm.DisplayOrder" />
            <span class="nf-hint">Lower numbers are listed first.</span>
        </Field>
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => groupOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveGroupAsync">Save</button>
    </Footer>
</Drawer>

<Drawer Open="forumOpen" Scrim="true" Title="@(forumForm.Id is null ? "New forum" : "Edit forum")" Width="min(560px, 100vw)" OnClose="() => forumOpen = false">
    <ChildContent>
        <Field Label="Group" For="forum-group">
            <InputSelect id="forum-group" class="nf-input" @bind-Value="forumForm.GroupId">
                @if (structure is not null)
                {
                    @foreach (var group in structure.Groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                }
            </InputSelect>
        </Field>
        <Field Label="Name" For="forum-name">
            <InputText id="forum-name" class="nf-input" @bind-Value="forumForm.Name" />
        </Field>
        <Field Label="Description" For="forum-description">
            <InputTextArea id="forum-description" class="nf-textarea" rows="4" @bind-Value="forumForm.Description" />
        </Field>
        <Field Label="Order" For="forum-order">
            <InputNumber id="forum-order" class="nf-input" @bind-Value="forumForm.DisplayOrder" />
        </Field>
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => forumOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveForumAsync">Save</button>
    </Footer>
</Drawer>

<Drawer Open="settingsOpen" Scrim="true" Title="Forum settings" Width="min(560px, 100vw)" OnClose="() => settingsOpen = false">
    <ChildContent>
        @if (settings is not null)
        {
            <Field Label="Topics per page" For="set-topics"><InputNumber id="set-topics" class="nf-input" @bind-Value="settings.TopicsPageSize" /></Field>
            <Field Label="Posts per page" For="set-posts"><InputNumber id="set-posts" class="nf-input" @bind-Value="settings.PostsPageSize" /></Field>
            <Field Label="Subject length" For="set-subject"><InputNumber id="set-subject" class="nf-input" @bind-Value="settings.SubjectMaxLength" /></Field>
            <Field Label="Post length" For="set-post"><InputNumber id="set-post" class="nf-input" @bind-Value="settings.PostMaxLength" /></Field>
            <label class="nf-check"><input type="checkbox" @bind="settings.AllowUsersToEditPosts" /> Members can edit their posts</label>
            <label class="nf-check"><input type="checkbox" @bind="settings.AllowUsersToDeletePosts" /> Members can delete their posts</label>
            <label class="nf-check"><input type="checkbox" @bind="settings.AllowUsersToManageSubscriptions" /> Members can subscribe</label>
            <label class="nf-check"><input type="checkbox" @bind="settings.SignaturesEnabled" /> Signatures</label>
            <label class="nf-check"><input type="checkbox" @bind="settings.RelativeDates" /> Relative dates</label>
            <label class="nf-check"><input type="checkbox" @bind="settings.FeedsEnabled" /> RSS feeds</label>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => settingsOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveSettingsAsync">Save</button>
    </Footer>
</Drawer>
