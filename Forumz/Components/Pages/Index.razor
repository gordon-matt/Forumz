@page "/"
@inject IForumService Forums
@inject TimeProvider Clock

<PageTitle>Forums</PageTitle>

<div class="fz-page">
    <PageHeader Title="Forums" Icon="chat" Description="Groups, forums, and the latest reply in each.">
        <Actions>
            <a class="nf-button" href="feed">RSS</a>
            @if (model?.CanManage == true)
            {
                <a class="nf-button nf-button-primary" href="manage">Manage</a>
            }
        </Actions>
    </PageHeader>

    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="The forums could not be loaded" Description="@error" />
    }
    else if (model!.Groups.Count == 0)
    {
        <EmptyState Icon="chat" Title="No forums yet" Description="An administrator can add the first group from Manage." />
    }
    else
    {
        @foreach (var group in model.Groups)
        {
            <section class="fz-group">
                <h2>@group.Name</h2>
                @if (group.Forums.Count == 0)
                {
                    <p class="nf-muted">No forums in this group.</p>
                }
                else
                {
                    <div class="nf-table-wrap">
                        <table class="nf-table">
                            <thead>
                                <tr>
                                    <th>Forum</th>
                                    <th class="nf-cell-number">Topics</th>
                                    <th class="nf-cell-number">Posts</th>
                                    <th>Last post</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var forum in group.Forums)
                                {
                                    <tr>
                                        <td>
                                            <a href="@($"forum/{forum.Id}")">@forum.Name</a>
                                            @if (forum.Description.Length > 0)
                                            {
                                                <div class="nf-hint">@forum.Description</div>
                                            }
                                        </td>
                                        <td class="nf-cell-number">@forum.TopicCount</td>
                                        <td class="nf-cell-number">@forum.PostCount</td>
                                        <td>
                                            @if (forum.LastPostTime is DateTime whenUtc && forum.LastTopicId is int topicId)
                                            {
                                                <a href="@($"topic/{topicId}")" title="@ForumTime.Exact(whenUtc)">@ForumTime.Format(whenUtc, relative, Clock)</a>
                                                <div class="nf-hint">@forum.LastAuthorName</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private ForumIndexModel? model;
    private string? error;
    private bool loading = true;
    private bool relative = true;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Forums.GetSettingsAsync();
        relative = !settings.IsSuccess || settings.Value.RelativeDates;
        var result = await Forums.GetIndexAsync();
        loading = false;
        if (!result.IsSuccess)
        {
            error = result.GetDisplayMessage();
            return;
        }

        model = result.Value;
    }
}
