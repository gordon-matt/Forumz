@page "/topic/{TopicId:int}"
@inject IForumService Forums
@inject ForumUrls Urls
@inject NavigationManager Navigation
@inject ForumClientContext Client
@inject ToastService Toasts
@inject DialogService Dialogs
@inject TimeProvider Clock
@inject IProfileProvider Profiles
@inject IOptions<ForumzOptions> Options

<PageTitle>@(model?.Subject ?? "Topic")</PageTitle>

<div class="fz-page">
    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="This topic could not be opened" Description="@error" />
    }
    else if (model is not null)
    {
        <nav class="nf-breadcrumbs" aria-label="Breadcrumb">
            <a href="@Urls.Home">Forums</a>
            <span aria-hidden="true">/</span>
            <span>@model.GroupName</span>
            <span aria-hidden="true">/</span>
            <a href="@Urls.To($"forum/{model.ForumId}")">@model.ForumName</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@model.Subject</span>
        </nav>
        <ForumHeading Title="@model.Subject" Description="@($"{model.Views} views")">
            <Actions>
                @if (model.TopicType != ForumTopicType.Normal)
                {
                    <span class="nf-badge nf-badge-accent">@model.TopicType</span>
                }
                @if (model.CanSubscribe)
                {
                    <button type="button" class="nf-button" @onclick="ToggleSubscriptionAsync">@(model.IsSubscribed ? "Unsubscribe" : "Subscribe")</button>
                }
                @if (model.CanModerate)
                {
                    <button type="button" class="nf-button" @onclick="OpenMove">Move</button>
                    <button type="button" class="nf-button nf-button-danger" @onclick="DeleteTopicAsync">Delete</button>
                }
            </Actions>
        </ForumHeading>

        @foreach (var post in model.Posts)
        {
            <article class="fz-post">
                <header class="fz-post-user">
                    <span class="fz-avatar" aria-hidden="true">
                        @if (photos.TryGetValue(post.AuthorUserId, out var photo))
                        {
                            <img src="@photo" alt="" />
                        }
                        else
                        {
                            @ForumInitials.From(post.AuthorName)
                        }
                    </span>
                    <div>
                        <span class="fz-user-name">@post.AuthorName</span>
                        <div class="fz-sub">@post.AuthorPostCount posts</div>
                    </div>
                </header>
                <div class="fz-post-main">
                    <div class="fz-post-body">
                        <div class="nf-markdown">@((MarkupString)post.Html)</div>
                        @if (!string.IsNullOrWhiteSpace(post.Signature))
                        {
                            <div class="fz-signature">@post.Signature</div>
                        }
                    </div>
                    <footer class="fz-post-foot">
                        <span title="@ForumTime.Exact(post.CreatedOnUtc)">
                            @ForumTime.Format(post.CreatedOnUtc, relative, Clock)
                            @if (post.UpdatedOnUtc > post.CreatedOnUtc.AddSeconds(1))
                            {
                                <span> · edited</span>
                            }
                        </span>
                        @if (post.CanEdit || post.CanDelete)
                        {
                            <span class="fz-actions">
                                @if (post.CanEdit)
                                {
                                    <button type="button" class="nf-button" @onclick="() => Edit(post)">Edit</button>
                                }
                                @if (post.CanDelete)
                                {
                                    <button type="button" class="nf-button nf-button-danger" @onclick="() => DeletePostAsync(post)">Delete</button>
                                }
                            </span>
                        }
                    </footer>
                </div>
            </article>
        }

        <Pager PageNumber="model.PageNumber" PageSize="model.PageSize" TotalCount="model.TotalCount" PageSizes="sizes" PageNumberChanged="Go" />

        @if (model.CanReply)
        {
            <section class="fz-board">
                <h2 class="fz-board-title">Reply</h2>
                <EditForm Model="reply" OnValidSubmit="ReplyAsync" class="fz-compose">
                    <PostComposer @bind-Text="reply.Text" @bind-Format="reply.Format" Label="Reply" />
                    <div class="nf-form-actions">
                        <button type="submit" class="nf-button nf-button-primary" disabled="@saving">Post reply</button>
                    </div>
                </EditForm>
            </section>
        }
    }
</div>

<Drawer Open="editing is not null" Scrim="true" Title="Edit post" Width="min(640px, 100vw)" OnClose="CloseEdit">
    <ChildContent>
        <PostComposer @bind-Text="editText" @bind-Format="editFormat" Label="Post" />
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="CloseEdit">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveEditAsync" disabled="@saving">Save</button>
    </Footer>
</Drawer>

<Drawer Open="moving" Scrim="true" Title="Move topic" Width="min(480px, 100vw)" OnClose="() => moving = false">
    <ChildContent>
        <Field Label="Forum" For="move-forum">
            <InputSelect id="move-forum" class="nf-input" @bind-Value="destinationForumId">
                @foreach (var choice in choices)
                {
                    <option value="@choice.Id">@choice.GroupName — @choice.Name</option>
                }
            </InputSelect>
        </Field>
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => moving = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="MoveAsync">Move</button>
    </Footer>
</Drawer>

@code {
    [Parameter]
    public int TopicId { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int PageNumber { get; set; }

    private readonly ReplyForm reply = new();
    private TopicPageModel? model;
    private string? error;
    private bool loading = true;
    private bool saving;
    private bool relative = true;
    private bool moving;
    private int[] sizes = [15];
    private int loadedId;
    private int loadedPage = -1;
    private PostModel? editing;
    private string editText = string.Empty;
    private ContentFormat editFormat = ContentFormat.Markdown;
    private int destinationForumId;
    private IReadOnlyList<ForumChoiceModel> choices = [];
    private IReadOnlyDictionary<string, string> photos = new Dictionary<string, string>();

    protected override async Task OnParametersSetAsync() => await LoadAsync(false);

    private async Task LoadAsync(bool force)
    {
        int page = PageNumber < 1 ? 1 : PageNumber;
        if (!force && loadedId == TopicId && loadedPage == page && model is not null)
        {
            return;
        }

        loadedId = TopicId;
        loadedPage = page;
        loading = model is null;
        var settings = await Forums.GetSettingsAsync();
        relative = !settings.IsSuccess || settings.Value.RelativeDates;
        var result = await Forums.GetTopicAsync(TopicId, page, countView: !force && model is null);
        loading = false;
        if (!result.IsSuccess)
        {
            error = result.GetDisplayMessage();
            model = null;
            return;
        }

        error = null;
        model = result.Value;
        sizes = [model.PageSize];
        photos = await LoadPhotosAsync(model.Posts.Select(post => post.AuthorUserId));
    }

    private async Task<IReadOnlyDictionary<string, string>> LoadPhotosAsync(IEnumerable<string> userIds)
    {
        var found = new Dictionary<string, string>(StringComparer.Ordinal);
        if (!Options.Value.ProfilePhotosEnabled)
        {
            return found;
        }

        foreach (string userId in userIds.Where(id => !string.IsNullOrWhiteSpace(id)).Distinct(StringComparer.Ordinal))
        {
            string uri = (await Profiles.GetAsync(userId)).PhotoUri;
            if (!string.IsNullOrWhiteSpace(uri))
            {
                found[userId] = uri;
            }
        }

        return found;
    }

    private void Go(int page) => Navigation.NavigateTo(Urls.To($"topic/{TopicId}?page={page}"));

    private async Task ReplyAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        var result = await Forums.CreatePostAsync(new CreatePostRequest(TopicId, reply.Text, reply.Format), Client.IpAddress);
        saving = false;
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        reply.Text = string.Empty;
        reply.Format = ContentFormat.Markdown;
        Toasts.Success("Reply posted.");
        await LoadAsync(true);
    }

    private void Edit(PostModel post)
    {
        editing = post;
        editText = post.Text;
        editFormat = post.Format;
    }

    private void CloseEdit() => editing = null;

    private async Task SaveEditAsync()
    {
        if (editing is null || saving)
        {
            return;
        }

        saving = true;
        var result = await Forums.UpdatePostAsync(new UpdatePostRequest(editing.Id, editText, editFormat));
        saving = false;
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        editing = null;
        Toasts.Success("Post updated.");
        await LoadAsync(true);
    }

    private async Task DeletePostAsync(PostModel post)
    {
        bool confirmed = await Dialogs.ConfirmAsync("Delete this post?", "This cannot be undone.", "Delete", isDestructive: true);
        if (!confirmed)
        {
            return;
        }

        var result = await Forums.DeletePostAsync(post.Id);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Post deleted.");
        var stillThere = await Forums.GetTopicAsync(TopicId, 1, countView: false);
        if (!stillThere.IsSuccess)
        {
            Navigation.NavigateTo(model is null ? Urls.Home : Urls.To($"forum/{model.ForumId}"));
            return;
        }

        await LoadAsync(true);
    }

    private async Task DeleteTopicAsync()
    {
        if (model is null)
        {
            return;
        }

        bool confirmed = await Dialogs.ConfirmAsync("Delete this topic?", "The topic and every reply will be removed.", "Delete", isDestructive: true);
        if (!confirmed)
        {
            return;
        }

        int forumId = model.ForumId;
        var result = await Forums.DeleteTopicAsync(TopicId);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Topic deleted.");
        Navigation.NavigateTo(Urls.To($"forum/{forumId}"));
    }

    private async Task ToggleSubscriptionAsync()
    {
        if (model is null)
        {
            return;
        }

        var result = model.IsSubscribed && model.SubscriptionId is int id
            ? await Forums.UnsubscribeAsync(id)
            : await Forums.SubscribeToTopicAsync(model.Id);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        await LoadAsync(true);
    }

    private async Task OpenMove()
    {
        var result = await Forums.GetForumChoicesAsync();
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        choices = result.Value;
        destinationForumId = model?.ForumId ?? choices.FirstOrDefault()?.Id ?? 0;
        moving = true;
    }

    private async Task MoveAsync()
    {
        var result = await Forums.MoveTopicAsync(TopicId, destinationForumId);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        moving = false;
        Toasts.Success("Topic moved.");
        await LoadAsync(true);
    }

    private sealed class ReplyForm
    {
        public string Text { get; set; } = string.Empty;

        public ContentFormat Format { get; set; } = ContentFormat.Markdown;
    }
}
