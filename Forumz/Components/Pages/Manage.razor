@page "/manage"
@inject IForumService Forums
@inject ToastService Toasts
@inject DialogService Dialogs

<PageTitle>Manage forums</PageTitle>

<div class="fz-page">
    <PageHeader Title="Manage forums" Icon="settings" Description="Groups, forums, and the settings that apply to everyone here.">
        <Actions>
            <div class="fz-actions">
                <button type="button" class="nf-button" @onclick="EditSettings">Settings</button>
                <button type="button" class="nf-button nf-button-primary" @onclick="NewGroup">New group</button>
            </div>
        </Actions>
    </PageHeader>

    @if (loading)
    {
        <p class="nf-muted">Loading…</p>
    }
    else if (error is not null)
    {
        <EmptyState Icon="warning" Title="Forums could not be loaded" Description="@error" />
    }
    else if (structure is not null && structure.Groups.Count == 0)
    {
        <EmptyState Icon="chat" Title="No groups yet" Description="Add a group, then add a forum inside it." />
    }
    else if (structure is not null)
    {
        @foreach (var group in structure.Groups)
        {
            <section class="fz-group">
                <div class="fz-actions">
                    <h2>@group.Name</h2>
                    <button type="button" class="nf-button" @onclick="() => EditGroup(group)">Edit</button>
                    <button type="button" class="nf-button" @onclick="() => NewForum(group.Id)">Add forum</button>
                    <button type="button" class="nf-button nf-button-danger" @onclick="() => DeleteGroupAsync(group)">Delete</button>
                </div>
                @if (group.Forums.Count == 0)
                {
                    <p class="nf-muted">No forums in this group.</p>
                }
                else
                {
                    <div class="nf-table-wrap">
                        <table class="nf-table">
                            <tbody>
                                @foreach (var forum in group.Forums)
                                {
                                    <tr>
                                        <td>
                                            <a href="@($"forum/{forum.Id}")">@forum.Name</a>
                                            @if (forum.Description.Length > 0)
                                            {
                                                <div class="nf-hint">@forum.Description</div>
                                            }
                                        </td>
                                        <td class="nf-cell-actions">
                                            <button type="button" class="nf-button" @onclick="() => EditForum(forum)">Edit</button>
                                            <button type="button" class="nf-button nf-button-danger" @onclick="() => DeleteForumAsync(forum)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

<Drawer Open="groupOpen" Scrim="true" Title="@(groupForm.Id is null ? "New group" : "Edit group")" Width="min(480px, 100vw)" OnClose="() => groupOpen = false">
    <ChildContent>
        <Field Label="Name" For="group-name">
            <InputText id="group-name" class="nf-input" @bind-Value="groupForm.Name" />
        </Field>
        <Field Label="Order" For="group-order">
            <InputNumber id="group-order" class="nf-input" @bind-Value="groupForm.DisplayOrder" />
            <span class="nf-hint">Lower numbers are listed first.</span>
        </Field>
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => groupOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveGroupAsync">Save</button>
    </Footer>
</Drawer>

<Drawer Open="forumOpen" Scrim="true" Title="@(forumForm.Id is null ? "New forum" : "Edit forum")" Width="min(560px, 100vw)" OnClose="() => forumOpen = false">
    <ChildContent>
        <Field Label="Group" For="forum-group">
            <InputSelect id="forum-group" class="nf-input" @bind-Value="forumForm.GroupId">
                @if (structure is not null)
                {
                    @foreach (var group in structure.Groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                }
            </InputSelect>
        </Field>
        <Field Label="Name" For="forum-name">
            <InputText id="forum-name" class="nf-input" @bind-Value="forumForm.Name" />
        </Field>
        <Field Label="Description" For="forum-description">
            <InputTextArea id="forum-description" class="nf-textarea" rows="4" @bind-Value="forumForm.Description" />
        </Field>
        <Field Label="Order" For="forum-order">
            <InputNumber id="forum-order" class="nf-input" @bind-Value="forumForm.DisplayOrder" />
        </Field>
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => forumOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveForumAsync">Save</button>
    </Footer>
</Drawer>

<Drawer Open="settingsOpen" Scrim="true" Title="Forum settings" Width="min(560px, 100vw)" OnClose="() => settingsOpen = false">
    <ChildContent>
        @if (settings is not null)
        {
            <Field Label="Topics per page" For="set-topics"><InputNumber id="set-topics" class="nf-input" @bind-Value="settings.TopicsPageSize" /></Field>
            <Field Label="Posts per page" For="set-posts"><InputNumber id="set-posts" class="nf-input" @bind-Value="settings.PostsPageSize" /></Field>
            <Field Label="Subject length" For="set-subject"><InputNumber id="set-subject" class="nf-input" @bind-Value="settings.SubjectMaxLength" /></Field>
            <Field Label="Post length" For="set-post"><InputNumber id="set-post" class="nf-input" @bind-Value="settings.PostMaxLength" /></Field>
            <label class="nf-field"><input type="checkbox" @bind="settings.AllowUsersToEditPosts" /> Members can edit their posts</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.AllowUsersToDeletePosts" /> Members can delete their posts</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.AllowUsersToManageSubscriptions" /> Members can subscribe</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.AllowPrivateMessages" /> Private messages</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.SignaturesEnabled" /> Signatures</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.RelativeDates" /> Relative dates</label>
            <label class="nf-field"><input type="checkbox" @bind="settings.FeedsEnabled" /> RSS feeds</label>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="nf-button" @onclick="() => settingsOpen = false">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" @onclick="SaveSettingsAsync">Save</button>
    </Footer>
</Drawer>

@code {
    private ForumStructureModel? structure;
    private string? error;
    private bool loading = true;
    private bool groupOpen;
    private bool forumOpen;
    private bool settingsOpen;
    private readonly GroupForm groupForm = new();
    private readonly ForumForm forumForm = new();
    private SettingsForm? settings;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = structure is null;
        var result = await Forums.GetStructureAsync();
        loading = false;
        if (!result.IsSuccess)
        {
            error = result.GetDisplayMessage();
            structure = null;
            return;
        }

        error = null;
        structure = result.Value;
    }

    private void NewGroup()
    {
        groupForm.Id = null;
        groupForm.Name = string.Empty;
        groupForm.DisplayOrder = (structure?.Groups.Count ?? 0) + 1;
        groupOpen = true;
    }

    private void EditGroup(ForumGroupEditModel group)
    {
        groupForm.Id = group.Id;
        groupForm.Name = group.Name;
        groupForm.DisplayOrder = group.DisplayOrder;
        groupOpen = true;
    }

    private async Task SaveGroupAsync()
    {
        var result = await Forums.SaveGroupAsync(new SaveForumGroupRequest(groupForm.Id, groupForm.Name, groupForm.DisplayOrder));
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        groupOpen = false;
        Toasts.Success("Group saved.");
        await LoadAsync();
    }

    private async Task DeleteGroupAsync(ForumGroupEditModel group)
    {
        bool confirmed = await Dialogs.ConfirmAsync("Delete this group?", group.Name, "Delete", isDestructive: true);
        if (!confirmed)
        {
            return;
        }

        var result = await Forums.DeleteGroupAsync(group.Id);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Group deleted.");
        await LoadAsync();
    }

    private void NewForum(int groupId)
    {
        forumForm.Id = null;
        forumForm.GroupId = groupId;
        forumForm.Name = string.Empty;
        forumForm.Description = string.Empty;
        forumForm.DisplayOrder = 1;
        forumOpen = true;
    }

    private void EditForum(ForumEditModel forum)
    {
        forumForm.Id = forum.Id;
        forumForm.GroupId = forum.GroupId;
        forumForm.Name = forum.Name;
        forumForm.Description = forum.Description;
        forumForm.DisplayOrder = forum.DisplayOrder;
        forumOpen = true;
    }

    private async Task SaveForumAsync()
    {
        var result = await Forums.SaveForumAsync(new SaveForumRequest(forumForm.Id, forumForm.GroupId, forumForm.Name, forumForm.Description, forumForm.DisplayOrder));
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        forumOpen = false;
        Toasts.Success("Forum saved.");
        await LoadAsync();
    }

    private async Task DeleteForumAsync(ForumEditModel forum)
    {
        bool confirmed = await Dialogs.ConfirmAsync(
            "Delete this forum?",
            "Topics and posts in it are deleted too.",
            "Delete",
            isDestructive: true,
            forum.Name);
        if (!confirmed)
        {
            return;
        }

        var result = await Forums.DeleteForumAsync(forum.Id);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Forum deleted.");
        await LoadAsync();
    }

    private async Task EditSettings()
    {
        var result = await Forums.GetSettingsAsync();
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        var value = result.Value;
        settings = new SettingsForm
        {
            AllowUsersToEditPosts = value.AllowUsersToEditPosts,
            AllowUsersToDeletePosts = value.AllowUsersToDeletePosts,
            AllowUsersToManageSubscriptions = value.AllowUsersToManageSubscriptions,
            AllowPrivateMessages = value.AllowPrivateMessages,
            RelativeDates = value.RelativeDates,
            FeedsEnabled = value.FeedsEnabled,
            SignaturesEnabled = value.SignaturesEnabled,
            TopicsPageSize = value.TopicsPageSize,
            PostsPageSize = value.PostsPageSize,
            SearchPageSize = value.SearchPageSize,
            ActivePageSize = value.ActivePageSize,
            MessagesPageSize = value.MessagesPageSize,
            SubscriptionsPageSize = value.SubscriptionsPageSize,
            SubjectMaxLength = value.SubjectMaxLength,
            PostMaxLength = value.PostMaxLength,
            MessageSubjectMaxLength = value.MessageSubjectMaxLength,
            MessageTextMaxLength = value.MessageTextMaxLength,
            SearchMinimumLength = value.SearchMinimumLength,
            FeedCount = value.FeedCount,
        };
        settingsOpen = true;
    }

    private async Task SaveSettingsAsync()
    {
        if (settings is null)
        {
            return;
        }

        var result = await Forums.SaveSettingsAsync(new SaveForumSettingsRequest(
            settings.AllowUsersToEditPosts,
            settings.AllowUsersToDeletePosts,
            settings.AllowUsersToManageSubscriptions,
            settings.AllowPrivateMessages,
            settings.RelativeDates,
            settings.FeedsEnabled,
            settings.SignaturesEnabled,
            settings.TopicsPageSize,
            settings.PostsPageSize,
            settings.SearchPageSize,
            settings.ActivePageSize,
            settings.MessagesPageSize,
            settings.SubscriptionsPageSize,
            settings.SubjectMaxLength,
            settings.PostMaxLength,
            settings.MessageSubjectMaxLength,
            settings.MessageTextMaxLength,
            settings.SearchMinimumLength,
            settings.FeedCount));
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        settingsOpen = false;
        Toasts.Success("Settings saved.");
    }

    private sealed class GroupForm
    {
        public int? Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public int DisplayOrder { get; set; }
    }

    private sealed class ForumForm
    {
        public int? Id { get; set; }

        public int GroupId { get; set; }

        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public int DisplayOrder { get; set; }
    }

    private sealed class SettingsForm
    {
        public bool AllowUsersToEditPosts { get; set; }

        public bool AllowUsersToDeletePosts { get; set; }

        public bool AllowUsersToManageSubscriptions { get; set; }

        public bool AllowPrivateMessages { get; set; }

        public bool RelativeDates { get; set; }

        public bool FeedsEnabled { get; set; }

        public bool SignaturesEnabled { get; set; }

        public int TopicsPageSize { get; set; }

        public int PostsPageSize { get; set; }

        public int SearchPageSize { get; set; }

        public int ActivePageSize { get; set; }

        public int MessagesPageSize { get; set; }

        public int SubscriptionsPageSize { get; set; }

        public int SubjectMaxLength { get; set; }

        public int PostMaxLength { get; set; }

        public int MessageSubjectMaxLength { get; set; }

        public int MessageTextMaxLength { get; set; }

        public int SearchMinimumLength { get; set; }

        public int FeedCount { get; set; }
    }
}
