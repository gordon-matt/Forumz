@page "/messages/new"
@inject IForumService Forums
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>New message</PageTitle>

<div class="fz-page">
    <nav class="nf-breadcrumbs" aria-label="Breadcrumb">
        <a href="messages">Messages</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">New</span>
    </nav>
    <PageHeader Title="New message" Icon="send" Description="Use the name they show on their posts." />
    <EditForm Model="form" OnValidSubmit="SendAsync">
        <Field Label="To" For="pm-to">
            <InputText id="pm-to" class="nf-input" @bind-Value="form.To" />
        </Field>
        <Field Label="Subject" For="pm-subject">
            <InputText id="pm-subject" class="nf-input" @bind-Value="form.Subject" />
        </Field>
        <Field Label="Message" For="pm-text">
            <InputTextArea id="pm-text" class="nf-textarea" rows="8" @bind-Value="form.Text" />
        </Field>
        <div class="nf-form-actions">
            <a class="nf-button" href="messages">Cancel</a>
            <button type="submit" class="nf-button nf-button-primary" disabled="@saving">Send</button>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    private readonly ComposeForm form = new();
    private bool saving;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(To) && form.To.Length == 0)
        {
            form.To = To;
        }
    }

    private async Task SendAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        var result = await Forums.SendMessageAsync(new SendMessageRequest(form.To, form.Subject, form.Text));
        saving = false;
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        Toasts.Success("Message sent.");
        Navigation.NavigateTo($"messages/{result.Value}");
    }

    private sealed class ComposeForm
    {
        public string To { get; set; } = string.Empty;

        public string Subject { get; set; } = string.Empty;

        public string Text { get; set; } = string.Empty;
    }
}
